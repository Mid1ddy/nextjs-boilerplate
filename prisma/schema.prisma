// Prisma schema for the game leaderboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  wins      Int      @default(0)
  kills     Int      @default(0)
  rounds    Int      @default(0)
  updatedAt DateTime @updatedAt
}
